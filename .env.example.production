# ── Application ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4010

# ── Database ───────────────────────────────────────────────────────────────────
# DATABASE_URL is the pooled runtime URL; DIRECT_DATABASE_URL is the direct
# connection used for Prisma migrations.
DATABASE_URL="postgresql://username:password@your-production-host-pooler.neon.tech/budgetify?sslmode=require&channel_binding=require"
DIRECT_DATABASE_URL="postgresql://username:password@your-production-host.neon.tech/budgetify?sslmode=require&channel_binding=require"

# ── Browser access and public URLs ─────────────────────────────────────────────
FRONTEND_URL=https://budgetify.nexcode.africa
PUBLIC_API_URL=https://budgetify-api.nexcode.africa
# Production origins must be exact HTTPS origins. Do not use local wildcards.
CORS_ALLOWED_ORIGINS=https://budgetify.nexcode.africa

# ── Mobile deep links ──────────────────────────────────────────────────────────
MOBILE_APP_INVITE_URL=budgetify://partnership/accept

# ── JWT authentication ─────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="replace-with-a-production-access-secret-of-at-least-32-characters"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET="replace-with-a-production-refresh-secret-of-at-least-32-characters"
JWT_REFRESH_EXPIRES_IN=7d

# ── Google OAuth ────────────────────────────────────────────────────────────────
# Add every Google OAuth client allowed to authenticate with the API.
GOOGLE_CLIENT_IDS="your-google-web-client-id.apps.googleusercontent.com,your-google-ios-client-id.apps.googleusercontent.com"

# ── Email OTP security ─────────────────────────────────────────────────────────
OTP_HASH_SECRET="replace-with-a-production-otp-secret-of-at-least-32-characters"

# ── iPhone Shortcut imports ───────────────────────────────────────────────────
# Generate a dedicated production secret; never reuse JWT or OTP secrets.
IPHONE_SHORTCUT_IMPORT_TOKEN_PEPPER="replace-with-a-production-shortcut-secret-of-at-least-32-characters"
# Generate independently in production with: openssl rand -base64 32
IPHONE_SHORTCUT_IMPORT_MESSAGE_ENCRYPTION_KEY="replace-with-a-base64-encoded-32-byte-key"

# ── Transactional email: Resend ────────────────────────────────────────────────
# Use a sending-only Resend key restricted to the verified sending domain.
RESEND_API_KEY=re_your_production_api_key
RESEND_FROM="Budgetify <no-reply@mail.budgetify.nexcode.africa>"
