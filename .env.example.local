# ── Application ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000

# ── Database ───────────────────────────────────────────────────────────────────
# Use a separate development database. DATABASE_URL is the pooled runtime URL;
# DIRECT_DATABASE_URL is the direct connection used for Prisma migrations.
DATABASE_URL="postgresql://username:password@your-development-host-pooler.neon.tech/budgetify_dev?sslmode=require&channel_binding=require"
DIRECT_DATABASE_URL="postgresql://username:password@your-development-host.neon.tech/budgetify_dev?sslmode=require&channel_binding=require"

# ── Browser access and public URLs ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:3001
PUBLIC_API_URL=http://127.0.0.1:8000
# Comma-separated browser origins. The :* wildcard is intended only for local
# development tools such as Flutter Web, which may use a dynamic port.
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:*,http://127.0.0.1:*

# ── JWT authentication ─────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="replace-with-a-local-access-secret-of-at-least-32-characters"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET="replace-with-a-local-refresh-secret-of-at-least-32-characters"
JWT_REFRESH_EXPIRES_IN=7d

# ── Google OAuth ────────────────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID supports one client. GOOGLE_CLIENT_IDS accepts a comma-
# separated list when web, Android, and iOS use different OAuth clients.
GOOGLE_CLIENT_ID="your-google-web-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_IDS="your-google-web-client-id.apps.googleusercontent.com,your-google-ios-client-id.apps.googleusercontent.com"

# ── Email OTP security ─────────────────────────────────────────────────────────
OTP_HASH_SECRET="replace-with-a-local-otp-secret-of-at-least-32-characters"

# ── Transactional email: Resend ────────────────────────────────────────────────
# Use a development-only Resend key. Never commit a real API key.
RESEND_API_KEY=re_your_development_api_key
RESEND_FROM="Budgetify <no-reply@mail.budgetify.nexcode.africa>"

# ── Image storage: local filesystem only ───────────────────────────────────────
# Local uploads are written beneath this directory and served by the API.
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIRECTORY=uploads
